<rml><head><title>Pause</title><link type="text/rcss" href="engine/ui/base.rcss"/><link type="text/rcss" href="theme.rcss"/></head>
<body data-model="example_settings"><div class="panel dialog"><h1>Paused</h1><p>Master: {{volume}}</p><input id="volume" class="range" type="range" min="0" max="100" data-value="volume"/><p>Music: {{music}}</p><input id="music" class="range" type="range" min="0" max="100" data-value="music"/><p>SFX: {{sfx}}</p><input id="sfx" class="range" type="range" min="0" max="100" data-value="sfx"/><p>UI: {{ui}}</p><input id="ui" class="range" type="range" min="0" max="100" data-value="ui"/><button id="test-audio">Test UI sound</button><p>Player name</p><input type="text" data-value="player"/><p class="hint">Music/SFX freeze while paused; UI remains audible.</p><button id="resume">Resume</button></div></body></rml>
